# Copy to .env and fill in. .env is ignored by git; never commit keys.

# Optional: raises the NVD rate limit. The lookup works without it.
NVD_API_KEY=

# Required: Ollama Cloud API key (https://ollama.com/settings/keys).
OLLAMA_API_KEY=

# Optional: override the model in config/settings.yaml (default gpt-oss:120b).
LLM_MODEL=
